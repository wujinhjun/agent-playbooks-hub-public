# ============================================================
# Bootstrap Ubuntu Coding Agent — 环境变量配置
# 用法:
#   cp bootstrap.env.example bootstrap.env
#   编辑 bootstrap.env 填你的值
#   然后 source bootstrap.env && bash apply-env.sh
# ============================================================

# ---- Git 身份（必填）----
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# ---- GitHub CLI（必填，gh auth 用）----
# 文档: https://cli.github.com/manual
# 生成: https://github.com/settings/tokens → classic token, 勾 repo + workflow
GITHUB_TOKEN=""

# ---- Mihomo 代理（不填则保留占位符，后续手动改 /etc/mihomo/config.yaml）----
# 文档: https://wiki.metacubex.one
# 第一跳：VPS 中转
MIHOMO_VPS_SERVER="vps.example.com"
MIHOMO_VPS_PORT="443"
MIHOMO_VPS_PASSWORD=""

# 第二跳：落地节点
MIHOMO_SG_SERVER="sg.ddns.example.com"
MIHOMO_SG_PORT="443"
MIHOMO_SG_UUID=""

# ---- Tailscale 组网（不填则装完后手动 sudo tailscale up）----
# 文档: https://tailscale.com/kb
# 生成: https://login.tailscale.com/admin/settings/keys → Generate auth key
TAILSCALE_AUTH_KEY=""

# ---- cc-connect IM 桥接（不填则装完后手动配 token）----
# 文档: https://github.com/anthropics/cc-connect
CC_CONNECT_TOKEN=""
