# ============================================================
# Bootstrap Ubuntu — 环境变量配置
# 位置: ~/.config/bootstrap-ubuntu/bootstrap.env
# 由 skill pre-flight 首次自动 seed，用户填值
# ============================================================

# ---- 模块选择（skill 在交互勾选后会自动覆写这一段）----
# 默认全 N；勾选什么 skill 就改成 Y
# INSTALL_MIRRORS=N
# INSTALL_GIT=N
# INSTALL_CLI=N
# INSTALL_TMUX=N
# INSTALL_MIHOMO=N
# INSTALL_TAILSCALE=N
# INSTALL_NODE=N
# INSTALL_GO=N
# INSTALL_PYTHON=N
# INSTALL_JAVA=N
# INSTALL_RUST=N
# INSTALL_FLUTTER=N
# INSTALL_DOCKER=N
# INSTALL_PUPPETEER=N
# INSTALL_CC_CONNECT=N
# INSTALL_CODEX=N
# INSTALL_ZSH=N
# INSTALL_CHEZMOI=N
# INSTALL_LAZY=N
# INSTALL_MULTI_AGENT=N

# ---- Git 身份 ----
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# ---- GitHub CLI ----
# 生成: https://github.com/settings/tokens → classic, 勾 repo + workflow
GITHUB_TOKEN=""

# ---- Mihomo 代理 ----
# 此 skill 不替换 mihomo config 内容，仅把
# ~/.config/bootstrap-ubuntu/mihomo-config.yaml 整个拷到 /etc/mihomo/config.yaml
# 自己按机场/自建节点格式编辑那个文件即可（任何 mihomo 支持的协议都行）。

# ---- Tailscale ----
# 生成: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=""

# ---- cc-connect IM 桥接 ----
# 文档: https://github.com/anthropics/cc-connect
CC_CONNECT_TOKEN=""
