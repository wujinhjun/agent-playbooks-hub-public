[Unit]
Description=cc-connect IM bridge (multi-agent)
After=network-online.target
Wants=network-online.target

[Service]
User=REPLACE_ME_USER
WorkingDirectory=/home/REPLACE_ME_USER
EnvironmentFile=/home/REPLACE_ME_USER/.config/cc-connect/secrets.env
Environment=NVM_DIR=/home/REPLACE_ME_USER/.nvm
Environment=PATH=/home/REPLACE_ME_USER/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/REPLACE_ME_USER/.nvm/versions/node/v24.16.0/bin/cc-connect -config /home/REPLACE_ME_USER/.cc-connect/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
